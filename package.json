{
  "name": "matriztica-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings=0",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:ui": "vitest",
    "e2e": "playwright test",
    "postinstall": "prisma generate",
    "deploy:check": "bash scripts/pre-deploy-check.sh",
    "deploy:vercel": "bash scripts/deploy.sh vercel",
    "deploy:railway": "bash scripts/deploy.sh railway",
    "migrate:prod": "bash scripts/migrate-prod.sh vercel",
    "setup:env": "bash scripts/setup-env.sh"
  },
  "dependencies": {
    "@auth/core": "^0.37.2",
    "@auth/prisma-adapter": "^1.5.3",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^6.18.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@react-pdf/renderer": "^3.4.4",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "next": "14.2.5",
    "next-auth": "^5.0.0-beta.25",
    "nodemailer": "^7.0.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.53.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.47",
    "prisma": "^6.18.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.20.6",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
