generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  entries   Entry[]
  accounts  Account[]
  sessions  Session[]
}

model Entry {
  id                String      @id @default(cuid())
  userId            String
  date              DateTime
  bienestar         Int         @default(3) // Nuevo campo: bienestar 1-5
  context           String?     // Lugar
  emotionPrimary    String?     // Emoción (puede ser null ahora)
  emotionIntensity  Int         @default(3)
  csiText           String?     // CSI (texto libre)
  doingsText        String?     // Operación
  reflectionText    String?     // Relación
  conversationText  String?     // Relación (duplicado por compatibilidad)
  conserve          String?
  transform         String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              User        @relation(fields: [userId], references: [id])
  domains           EntryDomain[]
  tags              EntryTag[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EntryDomain {
  id      String @id @default(cuid())
  entryId String
  domain  String
  entry   Entry  @relation(fields: [entryId], references: [id])
}

model Tag {
  id      String    @id @default(cuid())
  name    String    @unique
  entries EntryTag[]
}

model EntryTag {
  entryId String
  tagId   String
  entry   Entry @relation(fields: [entryId], references: [id])
  tag     Tag   @relation(fields: [tagId], references: [id])

  @@id([entryId, tagId])
}


